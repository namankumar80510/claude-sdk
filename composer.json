{
    "name": "dikki/claude-sdk",
    "description": "A powerful PHP SDK for Anthropic's Claude API",
    "type": "library",
    "website": "https://github.com/namankumar80510/claude-sdk",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/promises": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.7",
        "mockery/mockery": "^1.6",
        "symfony/var-dumper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Dikki\\Claude\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dikki\\Claude\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
